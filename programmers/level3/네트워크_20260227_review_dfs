def solution(n, computers):
    visited = [False] *n # 방문 여부 저장
    count = 0 #네트워크 개수
    
    # 바로 DFS 함수 정의 : 하나의 네트워크를 끝까지 다 방문 처리하는 역할
    def dfs(i):
        visited[i] = True # 일단 현재 컴퓨터부터 방문 처리
        
        # i번 컴퓨터와 연결된 모든 컴퓨터를 확인하기
        for j in range(n):
            if computers[i][j] == 1 and not visited[j]:
            # 연결 되어 있고 아직 방문 하지 않았다면
             dfs(j) # 그 컴퓨터로 깊게 들어가는 재귀 호출
    
    for i in range(n):
        if not visited[i]: # 아직 방문하지 않은 컴퓨터면
            dfs(i) # 그 컴 기준으로 재귀 방문처리 시작
            count += 1
            

    return count
