###### 연속합 문제 = 홀수 약수 개수 #####

def solution(n):
    cnt = 0
    # n의 약수를 제곱근까지만 탐색
    for i in range(1, int(n ** 0.5) + 1):
 # 첫 번째 약수: i
        if n % i == 0: # i가 n의 약수인지 확인
            
            if i % 2 == 1: # 홀수인지 확인
                cnt += 1

            # 짝이 되는 약수 n//i가 다른 값일 때
 # 두 번째 약수: n // i
            # i == n//i 인 경우는 제곱수일 때 (중복 방지)
            # n//i 가 i와 다르고, 홀수라면 카운트 증가
            if i != n // i and (n // i) % 2 == 1:
                cnt += 1
    return cnt 

연속된 자연수 합의 경우의 수는 n의 홀수 약수 개수와 동일
약수 탐색은 √n까지만 해서 효율 확보

# 브루트포스 
def solution(n):
    cnt = 0
    for start in range(1, n + 1):
        s = 0
        for x in range(start, n + 1):
            s += x
            if s == n:
                cnt += 1
                break
            if s > n:
                break
    return cnt
