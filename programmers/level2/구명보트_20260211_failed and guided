##두번째 답 , 결과: 효율성 테스트에서 하나 실패
def solution(people, limit):
    answer = 0
    people = sorted(people)

    while people:
#하나 남았을 때 예외처리해
        if len(people) == 1:
            answer += 1
            break

        if people[0] + people[-1] <= limit:
            people.pop(0)
            people.pop(-1)
            answer += 1
        else:
            people.pop(-1)
            answer += 1

    return answer


=> people.pop(0)은 리스트 맨 앞을 빼면서 뒤 원소를 전부 한 칸씩 당김 → O(n)
이걸 최대 5만 번 가까이 하면 O(n²) 급


