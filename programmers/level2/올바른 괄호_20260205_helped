def solution(s):
    count = 0
    
    for x in s:
        if x == '(':
            count += 1
        else:
            count -= 1
        
        if count < 0:  # )( 케이스 -> 음수로 표현되는 순간 즉시 탈락시킴!
            return False   # Boolean
    
    return count == 0      # Boolean


