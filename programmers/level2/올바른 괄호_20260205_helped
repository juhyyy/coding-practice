##############정석코드 

def solution(s):
    stack = []

    for x in s:
        if x == '(':
            stack.append(x)   # push
        else:  # ')'
            if not stack:     # pop 할 게 없음 → )가 먼저 나옴
                return False
            stack.pop()       # pop

    return len(stack) == 0    # 남은 '(' 있으면 False

