# 2트 -> 성공 
from math import gcd
def solution(arr):
    def lcm(a,b):
        return (a*b) // gcd(a,b)
        
    l = arr[0]
    for i in range(0,len(arr)-1):
        if i == 0:
            l = lcm(l, arr[i+1])
        else:
            l = lcm(l, arr[i+1])
    
    
    
    return l


