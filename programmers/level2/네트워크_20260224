연결된 컴퓨터 묶음이 몇 개인가?

문제 구조
- n개의 컴퓨터
- computers라는 2차원 배열
- computers[i][j] == 1이면 연결됨
- 네트워크(덩어리) 개수 구하기
덩어리 하나 시작할 때마다 +1
다 더하는 게 아니라 “시작 횟수”를 센다

####### 의사코드
for i in range(n):
    if 아직 방문 안 했으면:
        BFS(i)
        network_count += 1

###### 정답 코드


from collections import deque

def solution(n, computers):
    visited = [False] * n  # 각 컴퓨터 방문 여부
    count = 0  # 네트워크 개수
    
    for i in range(n):
        # 아직 방문하지 않은 컴퓨터라면
        if not visited[i]:
            count += 1  # 새로운 네트워크 시작
            
            queue = deque()
            queue.append(i)      # 시작 컴퓨터 큐에 넣기
            visited[i] = True    # 방문 처리
            
            # BFS 시작
            while queue:
                cur = queue.popleft()  # 현재 컴퓨터
                
                # 현재 컴퓨터와 연결된 모든 컴퓨터 확인
                for j in range(n):
                    # 연결되어 있고 아직 방문 안 했다면
                    if computers[cur][j] == 1 and not visited[j]:
                        visited[j] = True      # 방문 처리
                        queue.append(j)        # 큐에 추가
    
    return count  # 총 네트워크 개수 반환









