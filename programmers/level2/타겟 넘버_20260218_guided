STEP 3 — 분기 2개 추가
def solution(numbers, target):
    answer = 0
    
    def dfs(index, total):
        nonlocal answer
        
        # 1️⃣ 종료조건
        if index == len(numbers):
            if total == target:
                answer += 1
            return
        
        # 2️⃣ + 선택
        dfs(index + 1, total + numbers[index])
        
        # 3️⃣ - 선택
        dfs(index + 1, total - numbers[index])
    
    # 시작
    dfs(0, 0)
    
    return answer

