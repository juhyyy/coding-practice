from collections import Counter
def solution(s):
    a = []
    for x in s:
        a.append(x)
        
        
    if a[0] == ')':
        return False
    
    elif Counter(a)['('] == Counter(a)[')']: 
        return True

    else:
        return False

=> 개수가 같다가 “올바른 괄호”를 보장하지 않아서


# 순서 무시하고 총 개수만 같으면 True라서
# "())(()" 같은 중간에 깨지는 문자열을 통과시킴
