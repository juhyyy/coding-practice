#처음 코드

from collections import Counter
def solution(n, words):
    # 중복된 단어의 인덱스= i 구하기
    
    
# Counter(words)에서 2개 나온 것의 인덱스를 구하는 코드    
    cnt = Counter(words)

    for i, w in enumerate(words): #enumerate(cnt) 아님!!
        if cnt[w] == 2:
            i_2 = i 
        break
    
    person = (i_2 % n) + 1
    turn   = (i_2 // n) + 1
    answer = [person,turn]


    return answer


=>>>>
Counter는 단어의 총 등장 횟수만 제공하며,
영어 끝말잇기처럼 “처음 규칙이 깨지는 시점”을 찾는 문제에는
순차 탐색(set 기반)이 필요하다.

즉, ❗ 왜 이 코드가 구조적으로 안 맞냐면

break가 for문을 첫 턴에 끝내버림
Counter == 2는 “중복 존재”만 알려주지
“언제 처음 깨졌는지”는 절대 못 알려줌
끝말잇기는 순서 문제라 Counter가 주 도구가 아님 ✅ set을 쓰는 게 가장 안전하고 직관적



