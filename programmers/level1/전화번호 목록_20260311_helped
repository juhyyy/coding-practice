# 3트 
def solution(phone_book):
    for j in range(len(phone_book)):
        pre = phone_book[j]
        
        for i in range(len(phone_book)):
            if i == j:
                continue
            
            num = phone_book[i][0:len(pre)]
            
            if pre == num:
                return False
                
    return True


=> 효율성 통과 X . sort 사용해서 풀어보기

# 지피티 힌트 : startswith()

# 정답 코드 

def solution(phone_book):
    phone_book.sort()
    
    for i in range(len(phone_book)-1):
        if phone_book[i+1].startswith(phone_book[i]):
            return False
            
    return True
