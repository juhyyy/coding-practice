# 1트
def solution(phone_book):
    pre = phone_book[0]
    
    for i in range(1,len(phone_book)+1):
        num= phone_book[i][0:len(pre)+1]
        if pre == num:
            return True
        else:
            return False  => 첫 번째 비교에서 바로 함수가 끝난다.1가 아니면 바로 반환해버려서 2(다음숫자)까지 안감.

