def solution(s):
    numbers = {
        "zero": "0",
        "one": "1",
        "two": "2",
        "three": "3",
        "four": "4",
        "five": "5",
        "six": "6",
        "seven": "7",
        "eight": "8",
        "nine": "9"
    }
    
    for word, digit in numbers.items():
        s = s.replace(word, digit)
    
    return int(s)





'''
🔹 numbers.items()

뜻은:

(key, value) 쌍을 꺼내라

'''

######
💡 왜 이게 통하냐?

예를 들어:

"one4seveneight"

replace 과정:

one → 1
seven → 7
eight → 8

결과:

"1478"

→ int("1478")

끝.
