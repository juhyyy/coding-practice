def solution(left, right):
    even = []
    odd = []
    for i in range(left,right+1):
        a = []                             # 약수 리스트, 위치 중요 !!!!
        for x in range(1, right+1):
            #  <-  처음에 여기에 잘못 넣었음, 여기에 넣으면 계속 리셋됨
            if i % x == 0:
                a.append(x)
        count=len(set(a))        #중복이 안되어서 사실 set가 필요없다. 
        
        if count % 2 ==1:
            odd.append(i)
        else:
            even.append(i)
# even, odd 리스트를 굳이 둘 다 만들 필요가 있을까?
    answer = sum(even) - sum(odd)
    return answer
