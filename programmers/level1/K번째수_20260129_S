def solution(array, commands):
    answer = []
    for x in range(0,len(commands)):
        command = commands[x]
        i = command[0]
        j = command[1]
        k = command[2]
        
        new_arr = sorted(array[i-1:j])
        
        answer.append(new_arr[k-1])
    
    
    
    return answer
