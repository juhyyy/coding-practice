-- 코드를 작성해주세요
SELECT ID, 	SIZE_OF_COLONY <=100 AS LOW, 100<SIZE_OF_COLONY <1000 AS MEDIUM, 1000<SIZE_OF_COLONY AS HIGH
FROM ECOLI_DATA
ORDER BY ID ASC;

#2트
-- 코드를 작성해주세요
SELECT ID, 	SIZE_OF_COLONY AS SIZE
FROM ECOLI_DATA
WHERE IF SIZE <=100 AS 'LOW'ELSE 100<SIZE <1000 AS 'MEDIUM'ELSE 1000<SIZE AS 'HIGH'
ORDER BY ID ASC;


# 정답
SELECT 
    ID,
    CASE
        WHEN SIZE_OF_COLONY <= 100 THEN 'LOW'
        WHEN SIZE_OF_COLONY <= 1000 THEN 'MEDIUM'
        ELSE 'HIGH'
    END AS SIZE
FROM ECOLI_DATA
ORDER BY ID ASC;
