# 1트 # 오답 

SELECT CAR_ID	, ROUND(AVG(DATEDIFF(END_DATE, START_DATE)),3) AS AVERAGE_DURATION
FROM CAR_RENTAL_COMPANY_RENTAL_HISTORY
WHERE AVERAGE_DURATION >= 7
ORDER BY AVERAGE_DURATION DESC, CAR_ID DESC;


1.👉 WHERE에서는 별칭(alias) 못 쓴다.
2. AVG를 쓰고 있으면서
GROUP BY가 없다.


#2트
SELECT 
    CAR_ID,
    ROUND(AVG(DATEDIFF(END_DATE, START_DATE)), 3) AS AVERAGE_DURATION
FROM CAR_RENTAL_COMPANY_RENTAL_HISTORY
GROUP BY CAR_ID
HAVING AVG(DATEDIFF(END_DATE, START_DATE)) >= 7
ORDER BY AVERAGE_DURATION DESC, CAR_ID DESC;


# 3트 정답 
SELECT 
    CAR_ID,
    ROUND(AVG(DATEDIFF(END_DATE, START_DATE) + 1), 1) AS AVERAGE_DURATION
FROM CAR_RENTAL_COMPANY_RENTAL_HISTORY
GROUP BY CAR_ID
HAVING AVG(DATEDIFF(END_DATE, START_DATE) + 1) >= 7
ORDER BY AVERAGE_DURATION DESC, CAR_ID DESC;


🎯 최종 체크리스트

GROUP BY 있음 ✔
HAVING 사용 ✔
+1 처리 ✔
ROUND 자리수 1 ✔
ORDER BY 조건 정확 ✔
