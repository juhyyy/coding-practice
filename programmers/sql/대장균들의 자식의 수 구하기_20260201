SELECT ID, COUNT(PARENT_ID) AS CHILD_COUNT
FROM ECOLI_DATA AS E INNER JOIN E.ID = E.PARENT_ID
ORDER BY ID ASC;

#NULL일 때는 ~하라 는 표현 -> 0과 NULL은 다름.
#카운트 -> 집계 함수는 GROUP BY 써여함


##정답 쿼리

SELECT 
    P.ID,
    COUNT(C.ID) AS CHILD_COUNT
FROM ECOLI_DATA P
LEFT JOIN ECOLI_DATA C
    ON P.ID = C.PARENT_ID
GROUP BY P.ID
ORDER BY P.ID ASC;
