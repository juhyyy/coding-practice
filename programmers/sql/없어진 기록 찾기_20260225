

##첫시도
-- 코드를 입력하세요
SELECT I.ANIMAL_ID, I.NAME
FROM ANIMAL_INS AS I RIGHT JOIN ANIMAL_OUTS AS O ON I.ANIMAL_ID = O.ANIMAL_ID
WHERE I.DATETIME IS NULL  AND O.DATETIME IS NOT NULL

##정답코드
SELECT O.ANIMAL_ID, O.NAME
FROM ANIMAL_OUTS O
LEFT JOIN ANIMAL_INS I
ON O.ANIMAL_ID = I.ANIMAL_ID
WHERE I.ANIMAL_ID IS NULL
ORDER BY O.ANIMAL_ID;


SELECT O.ANIMAL_ID, O.NAME (기준 테이블의 컬럼으로 셀렉트 할 것)
👉 특히 DATETIME IS NULL 말고
 I.ANIMAL_ID IS NULL 로 체크하는 게 더 정확
JOIN 성공 여부를 가장 확실하게 알려주는 컬럼이 PK이기 때문
