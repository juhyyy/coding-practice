##잘못 푼 방법

-- 코드를 입력하세요
SELECT REST_ID.I, REST_NAME.I, FOOD_TYPE.I, FAVORITES.I, ADDRESS.I, ROUND(AVR(REVIEW_SCORE.R),3) AS SCORE
FROM REST_REVIEW AS R , REST_INFO AS I 
WHERE ADDRESS.I='서울%'
GROUP BY REST_ID.I, REST_NAME.I, FOOD_TYPE.I, FAVORITES.I, ADDRESS.I
ORDER BY SCORE DESC, FAVORITE.I DESC;


## 정답 
SELECT I.REST_ID, I.REST_NAME, I.FOOD_TYPE, I.FAVORITES, I.ADDRESS, ROUND(AVG(R.REVIEW_SCORE),2) AS SCORE
FROM REST_REVIEW AS R JOIN REST_INFO AS I ON R.REST_ID = I.REST_ID
WHERE I.ADDRESS LIKE '서울%'
GROUP BY I.REST_ID, I.REST_NAME, I.FOOD_TYPE, I.FAVORITES, I.ADDRESS
ORDER BY SCORE DESC, I.FAVORITES DESC;

