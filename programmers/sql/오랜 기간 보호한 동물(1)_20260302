## 1트

-- 코드를 입력하세요
SELECT I.NAME, I.DATETIME
FROM ANIMAL_INS AS I LEFT JOIN ANIMAL_OUTS AS O ON  I.ANIMAL_ID = O.ANIMAL_ID
ORDER BY I.DATETIME ASC
LIMIT 3; 

=> 이건 간 애들만 조회되는 거잖아.


## 2트 with 정답

-- 코드를 입력하세요
SELECT I.NAME, I.DATETIME
FROM ANIMAL_INS AS I LEFT JOIN ANIMAL_OUTS AS O ON  I.ANIMAL_ID = O.ANIMAL_ID
WHERE O.ANIMAL_ID IS NULL ###########걸러주는 포인트~~~~
ORDER BY I.DATETIME ASC
LIMIT 3; 
